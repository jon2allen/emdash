#!/bin/sh
# Portable Git pre-commit hook (POSIX sh compatible across macOS, Linux, FreeBSD)
# Automatically fixes Unicode dashes in staged files before committing.

# Locate Python 3 across systems (/usr/local/bin, /usr/bin, /opt/homebrew/bin, etc.)
PYTHON_BIN=""
if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN="python"
fi

if [ -z "$PYTHON_BIN" ]; then
    echo "[emdash pre-commit] Warning: python3 not found on PATH, skipping dash check." >&2
    exit 0
fi

# Locate detect_emdash.py in the user's hooks directory
SCRIPT_PATH="$HOME/.git_hooks/detect_emdash.py"
if [ ! -f "$SCRIPT_PATH" ]; then
    echo "[emdash pre-commit] Warning: $SCRIPT_PATH not found, skipping." >&2
    exit 0
fi

# Get list of staged files that are not deleted (diff-filter=d)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Run detect_emdash.py in fix mode on staged files
# We pass filenames safely to python
echo "$STAGED_FILES" | while IFS= read -r file; do
    if [ -f "$file" ]; then
        "$PYTHON_BIN" "$SCRIPT_PATH" -q --fix "$file"
        # Re-stage file if modified
        git add "$file"
    fi
done

exit 0

